	)
	(text "D1 (Red) - Power present. Lights up whenever valid input power (USB-C or adapter) is connected, regardless of charging state.\nD2 (Green) - Combines with D3 to show charge status:\nD2 only ON → Charging in progress\nD2 OFF, D3 ON → Charge complete\nBoth ON → No battery present / fault\nBoth OFF → No input power\nD3 (Blue) - Same STAT pair as above, but also doubles as a low-battery warning (~LBO) when not actively charging - it'll blink or light to flag a low battery."
		(exclude_from_sim no)
		(at 28.956 156.718 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b359d8e4-4756-42ed-8169-155a79cb4fb9")
	)
